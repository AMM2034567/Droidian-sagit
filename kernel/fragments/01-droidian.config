# Droidian kernel configuration fragment for Xiaomi Mi 6 (sagit)
# Target base: Linux 4.4 MSM8998 (Halium 9.0)

# Linux Namespaces (Container & Droidian Core)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Control Groups (cgroups)
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# Systemd & POSIX Filesystem features
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS4_FS=y
CONFIG_SECCOMP=y
CONFIG_FANOTIFY=y
CONFIG_TMPFS_POSIX_ACL=y

# Android Binder & Ashmem (Halium/libhybris)
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ASHMEM=y

# USB & Network (for USB RNDIS Telnet/SSH debugging)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
